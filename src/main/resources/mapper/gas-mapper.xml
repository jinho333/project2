<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 해당 파일에 모든 쿼리문을 작성 -->
<!-- namespace에는 xml파일과 연결할 Mapper interface 파일명을 패키지를 포함하여 적어주세요 -->
<mapper namespace="com.commit.project2.mapper.GasMapper">
  <resultMap id="gas" type="com.commit.project2.dto.GasDTO">
    <id column="GAS_ID" property="gasId"/>
    <result column="REGION_ID" property="regionId"/>
    <result column="YM" property="ym"/>
    <result column="AVG_TEMP" property="avgTemp"/>
    <result column="MAX_TEMP" property="maxTemp"/>
    <result column="MIN_TEMP" property="minTemp"/>
    <result column="HOUSEHOLD_CNT" property="householdCnt"/>
    <result column="SUPPLY" property="supply"/>
    <result column="POPULATION" property="population"/>

  </resultMap>

  <!-- 가스 월별 조회를 모은 공용 매퍼. 전국·지역 양쪽이 사용 -->
  <!-- 단위: SUPPLY = 천㎥, POPULATION = 명 (화면 단위 백만㎥·만 명 으로는 서비스에서 바꿈) -->
  <!-- REGION_ID 18 = '전국'(집계 행). 1~17 = 시·도 → 'REGION_ID = 18' 은 전국만, 'REGION_ID &lt; 18' 은 시·도만 -->

  <!--지역 페이지에 필요한 쿼리-->
  <!-- 한 지역의 전체 기간 월별 (region 파트 /stats 의 분기 집계·상관계수 계산용) -->
  <!-- 단위는 환산하지 않음 (서비스에서 처리) · 2021-01 ~ 최신월, 한 지역 ≈ 60여 행 -->
  <select id="getMonthlyByRegion" resultType="com.commit.project2.dto.GasDTO">
    SELECT
      g.YM         AS ym,
      g.AVG_TEMP   AS avgTemp,
      g.POPULATION AS population,
      g.SUPPLY     AS supply
    FROM gas_monthly g
    WHERE g.REGION_ID = #{regionId}
    ORDER BY g.YM
  </select>

  <!--전국 페이지에 필요한 쿼리-->
  <!-- 전국(REGION_ID 18) 연간 공급량 합계(천㎥) -->
  <select id="getNationalAnnualSupply" resultType="java.lang.Double">
    SELECT IFNULL(SUM(SUPPLY), 0)
    FROM gas_monthly
    WHERE REGION_ID = 18
      AND YM LIKE CONCAT(#{year}, '%')
  </select>

  <!-- 전국 월별 전체 (상관계수 계산용) -->
  <select id="getNationalMonthly" resultMap="gas">
    SELECT REGION_ID, YM, AVG_TEMP, SUPPLY, POPULATION, HOUSEHOLD_CNT
    FROM gas_monthly
    WHERE REGION_ID = 18
    ORDER BY YM
  </select>

  <!-- 전국 연도별 공급량 합계(천㎥)와 평균기온, 12개월이 모두 있는 연도만 (YM 칸에 연도를 담음) -->
  <select id="getNationalAnnual" resultMap="gas">
    SELECT LEFT(g.YM, 4) AS YM, SUM(g.SUPPLY) AS SUPPLY, ROUND(AVG(g.AVG_TEMP), 1) AS AVG_TEMP
    FROM gas_monthly g
    WHERE g.REGION_ID = 18
    GROUP BY LEFT(g.YM, 4)
    HAVING COUNT(*) = 12
    ORDER BY LEFT(g.YM, 4)
  </select>

  <!-- 12개월이 모두 있는 가장 최근 연도 (진행 중인 연도는 제외), 없으면 null -->
  <select id="getLatestFullYear" resultType="java.lang.String">
    SELECT MAX(y)
    FROM (
      SELECT LEFT(YM, 4) AS y
      FROM gas_monthly
      WHERE REGION_ID = 18
      GROUP BY LEFT(YM, 4)
      HAVING COUNT(*) = 12
    ) t
  </select>

</mapper>
